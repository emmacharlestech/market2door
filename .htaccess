# Market2Door — site-wide rules

<IfModule mod_rewrite.c>
  RewriteEngine On
  # One address for search engines: https://market2door.ng (no www, always HTTPS)
  RewriteCond %{HTTP_HOST} ^www\.market2door\.ng$ [NC]
  RewriteRule ^ https://market2door.ng%{REQUEST_URI} [L,R=301,NE]
  RewriteCond %{HTTP_HOST} ^market2door\.ng$ [NC]
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://market2door.ng%{REQUEST_URI} [L,R=301,NE]
</IfModule>

<IfModule mod_headers.c>
  # CSS/JS links carry ?v=…, so browsers may keep them for a year
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Photos, logos and fonts: a month
  <FilesMatch "\.(webp|jpe?g|png|svg|ico|woff2?)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  # The page itself: always check for a newer version
  <FilesMatch "\.html?$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType application/manifest+json .webmanifest
</IfModule>
